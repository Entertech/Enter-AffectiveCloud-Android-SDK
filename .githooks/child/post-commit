#!/bin/sh
set -eu

CHILD_ROOT="$(git rev-parse --show-toplevel)"
PARENT_ROOT="${SUBMODULE_SYNC_ROOT:-$(cd "${CHILD_ROOT}/../../.." && pwd)}"
SYNC_SCRIPT="${SUBMODULE_SYNC_SCRIPT:-${PARENT_ROOT}/scripts/submodule_branch_sync.py}"
SYNC_LOG="${SUBMODULE_SYNC_LOG:-${PARENT_ROOT}/.git/codex-submodule-sync/sync.log}"

log_sync() {
  mkdir -p "$(dirname "${SYNC_LOG}")" 2>/dev/null || true
  printf '%s child post-commit %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*" >> "${SYNC_LOG}" 2>/dev/null || true
}

run_python() {
  if command -v python3 >/dev/null 2>&1; then
    python3 "$@"
  elif command -v python >/dev/null 2>&1; then
    python "$@"
  elif command -v py >/dev/null 2>&1; then
    py -3 "$@"
  else
    echo "Python 3 is required for submodule branch sync." >&2
    exit 1
  fi
}

log_sync "start child=${CHILD_ROOT}"
if SUBMODULE_SYNC_ROOT="${PARENT_ROOT}" run_python "${SYNC_SCRIPT}" record-child; then
  log_sync "ok child=${CHILD_ROOT}"
else
  status=$?
  log_sync "failed status=${status} child=${CHILD_ROOT}"
  exit "${status}"
fi

if [ "${SUBMODULE_SYNC_AUTO_PARENT_COMMIT:-0}" = "1" ]; then
  if ! git -C "${PARENT_ROOT}" diff --cached --quiet -- affective_local_sdk/src/main; then
    git -C "${PARENT_ROOT}" commit -m "[codex] update algorithm submodule pointer" -- affective_local_sdk/src/main
  fi
fi
