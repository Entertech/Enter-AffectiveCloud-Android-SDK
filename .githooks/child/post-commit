#!/bin/sh
set -eu

CHILD_ROOT="$(git rev-parse --show-toplevel)"
PARENT_ROOT="$(cd "${CHILD_ROOT}/../../.." && pwd)"

run_python() {
  if command -v python3 >/dev/null 2>&1; then
    python3 "$@"
  elif command -v python >/dev/null 2>&1; then
    python "$@"
  elif command -v py >/dev/null 2>&1; then
    py -3 "$@"
  else
    echo "Python 3 is required for submodule branch sync." >&2
    exit 1
  fi
}

run_python "${PARENT_ROOT}/scripts/submodule_branch_sync.py" record-child

if [ "${SUBMODULE_SYNC_AUTO_PARENT_COMMIT:-0}" = "1" ]; then
  if ! git -C "${PARENT_ROOT}" diff --cached --quiet -- affective_local_sdk/src/main; then
    git -C "${PARENT_ROOT}" commit -m "[codex] update algorithm submodule pointer" -- affective_local_sdk/src/main
  fi
fi
